# Нормализация переводов строк (Windows-файлы .bat/.py — с CRLF).
*.py   text eol=crlf
*.bat  text eol=crlf
*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf

# Собранные Windows EXE не хранятся в Git: их публикуют как CI artifacts/Releases.
# Generated Windows EXEs stay out of Git and are published as CI artifacts/Releases.
