# Python bytecode, test/analysis caches, and virtual environments
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
.venv/
venv/
.coverage*
coverage.xml
coverage.json
htmlcov/

# Node dependencies and generated logs/temp files
node_modules/
*.log
*.tmp
*.bak
*~
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Application data, logs, local runtimes, and build output
source/data/
source/logs/
source/build/
source/.venv/
source/.build-venv/
source/runtime/
build/
dist/data/
dist/logs/
dist/release-artifacts/
alt

# Locally built Windows binaries are distributed through Actions artifacts/Releases,
# not committed to the source repository.
dist/*.exe

# Generated/stale illustrations not used by the app or current documentation.
source/images/flow.png
source/images/langs.png
source/images/langs.svg
source/images/settings_test.png
source/images/settings.png
# Keep forum graphics embedded by FORUM_BBCODE; other generated previews are optional.
source/images/forum/*.png
!source/images/forum/post_*.png
!source/images/forum/sm_header.png
!source/images/forum/sm_header_en.png
